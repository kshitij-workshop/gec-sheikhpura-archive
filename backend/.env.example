DB_URL=jdbc:postgresql://localhost:5432/gecs_archive
DB_USERNAME=gecs
DB_PASSWORD=gecs_dev_password
DB_POOL_MAX_SIZE=10
CORS_ALLOWED_ORIGINS=http://localhost:5173

