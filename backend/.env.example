# Backend environment variables.
# Spring Boot does not load this file automatically. Export these values in
# your shell or configure them in your IDE/run configuration.
# Development defaults live in application-dev.yml.
# Never commit a real .env file.

SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/gecs_archive
DB_USERNAME=gecs
DB_PASSWORD=gecs_dev_password
DB_POOL_MAX_SIZE=10
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Phase 02
# JWT_SIGNING_KEY=
# REFRESH_TOKEN_PEPPER=

# Phase 04
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Production email uses Brevo's HTTPS API because Render Free blocks outbound SMTP.
# BREVO_API_KEY must be a Brevo API key (SMTP & API -> API Keys), not an SMTP key.
# BREVO_API_KEY=
# MAIL_FROM=verified-sender@example.com
# MAIL_FROM_NAME=GEC Sheikhpura Archive
# SMTP timeout overrides for local/non-production SMTP, in milliseconds.
# MAIL_SMTP_CONNECTION_TIMEOUT=5000
# MAIL_SMTP_READ_TIMEOUT=10000
# MAIL_SMTP_WRITE_TIMEOUT=10000
