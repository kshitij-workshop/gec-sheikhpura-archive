# Public browser configuration only. Never place secrets in VITE_* variables.
# The default keeps requests same-origin so the Vite proxy and the production
# Vercel rewrite both work without extra configuration.
VITE_API_BASE_URL=/api/v1

# Public Cloudinary cloud name used to build image delivery URLs.
# This is not a secret. Leave empty and galleries show an explicit placeholder
# instead of requesting images from an unknown cloud.
VITE_CLOUDINARY_CLOUD_NAME=

# Optional: dev-server proxy target. Read by vite.config.ts, not by the browser.
VITE_API_PROXY_TARGET=http://localhost:8080
