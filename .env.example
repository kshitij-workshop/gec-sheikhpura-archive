# Local Docker Compose configuration.
# Copy this file to .env for custom local ports or credentials.
# Never commit .env.

POSTGRES_DB=gecs_archive
POSTGRES_USER=gecs
POSTGRES_PASSWORD=gecs_dev_password
POSTGRES_PORT=5432

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Backend authentication settings.
# The dev profile already provides a development-only JWT secret; production
# must supply its own value of at least 32 bytes.
# APP_JWT_SECRET=
# APP_JWT_ISSUER=https://gecs-archive.example
# APP_REFRESH_COOKIE_SECURE=false
# APP_FRONTEND_BASE_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Mail delivery (Mailpit locally).
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# One-time first SUPER_ADMIN bootstrap. Leave unset unless initializing a new
# environment, and remove after the first successful start.
# APP_BOOTSTRAP_SUPER_ADMIN_EMAIL=
# APP_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# APP_BOOTSTRAP_SUPER_ADMIN_DISPLAY_NAME=Archive Administrator

# Cloudinary upload configuration. Required for Phase 04 upload APIs.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PRESET=
# CLOUDINARY_UPLOAD_FOLDER=gecs-archive
# CLOUDINARY_SECURE_DELIVERY=true
# APP_UPLOAD_MAX_FILE_SIZE_BYTES=15728640
# APP_UPLOAD_MAX_PHOTOS_PER_SUBMISSION=50
# APP_UPLOAD_AUTHORIZATION_TTL=10m
